# Copie ce fichier en ".env.local" (déjà fait automatiquement) et
# remplace les valeurs ci-dessous par celles de ton projet Supabase :
# Dashboard Supabase > Project Settings > API.
#
# Ces deux valeurs ne sont PAS secrètes (elles sont conçues pour être
# utilisées côté navigateur) — la sécurité est assurée par les règles
# RLS définies dans supabase/schema.sql, pas par le secret de ces clés.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Envoi des quittances par email (Resend) — CETTE clé est secrète, ne jamais la commiter ni la
# partager. Nécessite un domaine vérifié dans le tableau de bord Resend (resend.com/domains).
# Sans ces deux variables, le bouton "Envoyer par email" affiche un message d'erreur clair au
# lieu de planter.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM_ADDRESS="PATRIMONIUM <quittances@ton-domaine.fr>"
